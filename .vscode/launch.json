{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        // run `just devd` first.
        {
            "type": "java",
            "request": "attach",
            "name": "Debug (Attach) - Remote (VSCode)",
            "hostName": "127.0.0.1",
            "port": 5005
        },
        {
            "name": "Debug leetcode-auth-stealer-service (will launch 4 u)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/internal/leetcode-auth-stealer-service/src/server.py",
            "cwd": "${workspaceFolder}/internal/leetcode-auth-stealer-service",
            "console": "integratedTerminal",
            "env": {
                "GRPC_REFLECTION": "true",
                "GRPC_VERBOSITY": "ERROR"
            }
        }
    ]
}
