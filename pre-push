#!/bin/bash
# Checks every outgoing commit, so a plaintext secret committed before the hooks were installed
# cannot be pushed. Git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
ZERO=0000000000000000000000000000000000000000
EXIT_CODE=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    # Deleting a remote branch pushes no commits.
    [ "$LOCAL_SHA" = "$ZERO" ] && continue

    if [ "$REMOTE_SHA" = "$ZERO" ]; then
        COMMITS=$(git rev-list "$LOCAL_SHA" --not --remotes)
    else
        COMMITS=$(git rev-list "$REMOTE_SHA..$LOCAL_SHA")
    fi

    for COMMIT in $COMMITS; do
        FILES=$(git diff-tree --no-commit-id --name-only -r --diff-filter=ACMR "$COMMIT" | grep -E '\.env\.shared\.yaml$')
        for FILE in $FILES; do
            if ! git show "$COMMIT:$FILE" | grep -q "sops:"; then
                echo "--------------------------------------------------------"
                echo "ERROR: Unencrypted secret file in commit $(git rev-parse --short "$COMMIT"): $FILE"
                echo "Encrypt it with \`just encrypt $FILE\` and rewrite that commit before pushing."
                echo "--------------------------------------------------------"
                EXIT_CODE=1
            fi
        done
    done
done
exit $EXIT_CODE
