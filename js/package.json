{
    "name": "codebloom-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc -b --noEmit",
        "vt": "vitest run",
        "test": "pnpm run typecheck && pnpm run prettier && pnpm run lint && pnpm run build && pnpm run vt",
        "fix": "pnpm run eslint:fix && pnpm run stylelint:fix && pnpm run prettier:fix",
        "lint": "pnpm run eslint && pnpm run stylelint",
        "generate": "openapi-typescript http://localhost:8080/v3/api-docs -o src/lib/api/types/schema.ts --properties-required-by-default --enum --make-paths-enum --dedupe-enums && prettier --write \"src/lib/api/types/schema.ts\"",
        "generate:dev": "nodemon --watch ../ --ext java --exec \"pnpm run generate\"",
        "eslint": "eslint .",
        "eslint:fix": "eslint . --fix",
        "stylelint": "stylelint '**/*.css'",
        "stylelint:fix": "stylelint '**/*.css' --fix",
        "prettier": "prettier --check .",
        "prettier:fix": "prettier --write .",
        "preview": "vite preview"
    },
    "dependencies": {
        "@mantine/core": "^9.7.3",
        "@mantine/dates": "^9.7.3",
        "@mantine/form": "^9.7.3",
        "@mantine/hooks": "^9.7.3",
        "@mantine/notifications": "^9.7.3",
        "@microsoft/fetch-event-source": "^2.0.1",
        "@tabler/icons-react": "^3.49.0",
        "@tanstack/react-query": "^5.104.5",
        "@tanstack/react-query-devtools": "^5.104.5",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.23",
        "immer": "^11.2.9",
        "mantine-form-zod-resolver": "^1.3.0",
        "motion": "^14.6.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-icons": "^5.7.0",
        "react-router": "^8.5.0",
        "react-router-dom": "^7.18.4",
        "react-shiki": "^0.11.2",
        "type-fest": "github:tahminator/type-fest#main",
        "use-debounce": "^10.1.1",
        "use-immer": "^0.11.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/plugin-kit": ">=0.7.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-istanbul": "^5.0.5",
        "@vitest/coverage-v8": "5.0.5",
        "eslint": "^10.13.0",
        "eslint-plugin-no-relative-import-paths": "^1.7.3",
        "eslint-plugin-perfectionist": "^5.13.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "msw": "^3.0.3",
        "nodemon": "^3.1.14",
        "openapi-typescript": "7.8.0",
        "postcss": "^8.5.31",
        "postcss-preset-mantine": "^1.18.0",
        "postcss-simple-vars": "^7.0.1",
        "prettier": "^3.9.10",
        "sass": "^1.106.1",
        "stylelint": "^17.16.0",
        "stylelint-config-recommended": "^18.0.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~7.0.2",
        "typescript-eslint": "^8.72.0",
        "uuid": "^14.0.3",
        "vite": ">=7.3.6 <9",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^5.0.5"
    },
    "packageManager": "pnpm@10.24.0",
    "pnpm": {
        "patchedDependencies": {
            "openapi-typescript@7.8.0": "patches/openapi-typescript@7.8.0.patch"
        },
        "overrides": {
            "minimatch": ">=9.0.7",
            "minimatch@<3.1.4": "3.1.4",
            "@babel/helpers": ">=7.26.10",
            "@babel/core@<=7.29.0": ">=7.29.6 <8",
            "ajv@<6.14.0": "6.14.0",
            "ajv@8": ">=8.18.0 <9",
            "@eslint/plugin-kit": ">=0.7.3",
            "brace-expansion@<2": "1.1.18",
            "brace-expansion@>=3.0.0 <5.0.9": ">=5.0.9 <6",
            "flatted@<=3.4.1": ">=3.4.2 <4",
            "picomatch": "4.0.5",
            "yaml@>=2.0.0 <2.8.3": ">=2.8.3 <3",
            "postcss@<=8.5.22": ">=8.5.23 <9",
            "ws@>=8.0.0 <8.21.0": ">=8.21.0 <9",
            "uuid@>=13.0.0 <13.0.1": "13.0.1",
            "immutable@>=5.0.0-beta.1 <5.1.8": ">=5.1.8 <6"
        }
    }
}
