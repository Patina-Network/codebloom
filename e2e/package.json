{
    "name": "e2e",
    "version": "1.0.0",
    "description": "CodeBloom E2E",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "proto:generate": "buf generate ../internal/leetcode-auth-service/proto/v1 --template buf.gen.yaml",
        "postinstall": "pnpm run proto:generate",
        "e2e-install": "pnpm exec playwright install --with-deps",
        "e2e": "pnpm run e2e-install && pnpm exec playwright test",
        "e2e-codegen": "pnpm run e2e-install && pnpx playwright codegen http://localhost:5173",
        "test": "pnpm run typecheck && pnpm run prettier && pnpm run lint",
        "fix": "pnpm run eslint:fix && pnpm run prettier:fix",
        "lint": "pnpm run eslint",
        "eslint": "eslint .",
        "eslint:fix": "eslint . --fix",
        "prettier": "prettier --check .",
        "prettier:fix": "prettier --write ."
    },
    "keywords": [],
    "author": "Tahmid Ahmed",
    "license": "MIT",
    "devDependencies": {
        "@bufbuild/buf": "^1.75.0",
        "@bufbuild/protobuf": "^2.17.0",
        "@eslint/js": "^9.39.2",
        "@playwright/test": "^1.65.1",
        "@types/bun": "^1.3.6",
        "@types/mailparser": "^3.9.0",
        "@types/node": "^25.3.3",
        "eslint": "^9.0.2",
        "eslint-plugin-no-relative-import-paths": "^1.6.1",
        "eslint-plugin-perfectionist": "^5.3.1",
        "global": "^4.4.0",
        "globals": "^17.4.0",
        "imapflow": "^2.12.1",
        "mailparser": "^3.14.4",
        "nice-grpc": "^2.1.18",
        "nice-grpc-common": "^2.0.4",
        "prettier": "^3.8.0",
        "ts-proto": "^2.22.0",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.53.0"
    },
    "patchedDependencies": {},
    "pnpm": {
        "overrides": {
            "brace-expansion@<2": ">=1.1.18 <2",
            "brace-expansion@>=3.0.0 <5.0.9": ">=5.0.9 <6",
            "flatted@<3.4.2": ">=3.4.2 <4",
            "picomatch@>=4.0.0 <4.0.4": ">=4.0.4 <5"
        }
    }
}
