{
    "name": "e2e",
    "version": "1.0.0",
    "description": "CodeBloom E2E",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "e2e-install": "pnpm exec playwright install --with-deps",
        "e2e": "pnpm run e2e-install && pnpm exec playwright test",
        "e2e-codegen": "pnpm run e2e-install && pnpx playwright codegen http://localhost:5173",
        "test": "pnpm run typecheck && pnpm run prettier && pnpm run lint",
        "fix": "pnpm run eslint:fix && pnpm run prettier:fix",
        "lint": "pnpm run eslint",
        "eslint": "eslint .",
        "eslint:fix": "eslint . --fix",
        "prettier": "prettier --check .",
        "prettier:fix": "prettier --write ."
    },
    "keywords": [],
    "author": "Tahmid Ahmed",
    "license": "MIT",
    "dependencies": {},
    "devDependencies": {
        "globals": "^17.13.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@types/bun": "^1.4.3",
        "@types/node": "^26.6.5",
        "eslint": "^10.12.0",
        "eslint-plugin-no-relative-import-paths": "^1.7.3",
        "eslint-plugin-perfectionist": "^5.12.1",
        "global": "^4.4.0",
        "prettier": "^3.9.10",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.71.1"
    },
    "patchedDependencies": {},
    "packageManager": "pnpm@10.24.0",
    "pnpm": {
        "overrides": {
            "brace-expansion@<2": ">=1.1.18 <2",
            "brace-expansion@>=3.0.0 <5.0.9": ">=5.0.9 <6",
            "flatted@<3.4.2": ">=3.4.2 <4",
            "picomatch@>=4.0.0 <4.0.4": ">=4.0.4 <5"
        }
    }
}
